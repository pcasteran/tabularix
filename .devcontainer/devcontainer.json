// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Tabularix",

  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },

  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "nefrob.vscode-just-syntax",
        "tobiashochguertel.just-formatter",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "gruntfuggly.todo-tree",
        "buenon.scratchpads",
        // Python
        "ms-python.python",
        "charliermarsh.ruff",
        "astral-sh.ty",
        // Robot Framework
        "d-biehl.robotcode"
      ]
    }
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    // Use the "Docker outside of Docker" feature to allow building the application Docker image.
    // We don't use "Docker-in-Docker" to keep the dev container small and avoid losing the Docker cache on devcontainer restart.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "mounts": [
    // Podman socket (Rootless support following official feature documentation).
    // The `docker-outside-of-docker` feature internally uses /var/run/docker-host.sock as the mount point for the host socket when overridden.
    {
      "type": "bind",
      "source": "${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock",
      "target": "/var/run/docker-host.sock"
    },

    // Use some volumes to persist tools configuration upon container restart.
    {
      "type": "volume",
      "source": "${localWorkspaceFolderBasename}-prek-cache",
      "target": "/home/vscode/.cache/prek"
    },
    {
      "type": "volume",
      "source": "${localWorkspaceFolderBasename}-gemini-cache",
      "target": "/home/vscode/.gemini"
    }
  ],

  "containerEnv": {
    // Trust the mise config in the repository root.
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces"
  }
}
